{
  "manifest_version": 3,
  "name": "Authored",
  "version": "0.1.0",
  "description": "A quiet, distraction-free writing room for Google Docs.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/d/*"
      ],
      "js": [
        "content/core.js",
        "content/selectors.js",
        "content/focus-mode.js",
        "content/fullscreen.js",
        "content/centering.js",
        "content/wordcount.js",
        "content/goal.js",
        "content/sound.js",
        "content/lastplace.js",
        "content/welcome.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*.css",
        "assets/sounds/*",
        "assets/sounds/*/*"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle focus mode"
    },
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Toggle fullscreen"
    },
    "toggle-typewriter": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Toggle centred typing"
    },
    "toggle-sound": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle key sounds"
    },
    "toggle-drawer": {
      "description": "Open or close the settings drawer"
    },
    "jump-back": {
      "description": "Back to where I was writing"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
